# Backend
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1
APP_ENV=development
APP_DATABASE_URL=postgresql+asyncpg://rag:rag@127.0.0.1:56432/rag_hub
APP_REDIS_URL=redis://127.0.0.1:57379/0
APP_CORS_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:4174,http://localhost:4173,http://localhost:4174
APP_AUTO_CREATE_DB=true
APP_TASK_MODE=inline
APP_EMBEDDING_BATCH_SIZE=64

# Development bootstrap account. Change both in production.
APP_BOOTSTRAP_ADMIN_EMAIL=admin@fde.local
APP_BOOTSTRAP_ADMIN_PASSWORD=fde-dev-admin
# Production: APP_AUTO_CREATE_DB=false, then run `uv run alembic upgrade head`.

# Replace before production. `openssl rand -base64 32` is a suitable source.
APP_ENCRYPTION_KEY=development-only-change-me

# Object storage: local for direct development; s3 for Docker Compose/production.
APP_STORAGE_BACKEND=local
APP_LOCAL_STORAGE_PATH=./backend/data/uploads
APP_S3_ENDPOINT_URL=http://127.0.0.1:59000
APP_S3_ACCESS_KEY=rag-minio
APP_S3_SECRET_KEY=change-this-minio-secret
APP_S3_BUCKET=rag-documents
APP_S3_REGION=us-east-1

# OCR is disabled until a cloud provider is configured.
APP_OCR_PROVIDER=disabled
APP_OCR_MODEL_NAME=qwen-vl-max
APP_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_OCR_API_KEY=

